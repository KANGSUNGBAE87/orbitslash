# Public browser env only. Do not put service-role, DB, provider, store, or console secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep false/blank until matching remote migrations and Edge Functions are
# deployed and verified. Public Supabase env alone must not imply readiness.
VITE_RANKED_EDGE_REMOTE_ENABLED=
VITE_PUBLIC_LEADERBOARD_ENABLED=
VITE_REWARDED_AD_TELEMETRY_REMOTE_ENABLED=
VITE_REWARDED_AD_TELEMETRY_REMOTE_VERIFIED=
VITE_GAMEPLAY_TELEMETRY_REMOTE_ENABLED=
VITE_GAMEPLAY_TELEMETRY_REMOTE_VERIFIED=
VITE_PRODUCT_TELEMETRY_REMOTE_ENABLED=
VITE_PRODUCT_TELEMETRY_REMOTE_VERIFIED=
VITE_PROGRESS_SYNC_REMOTE_ENABLED=
VITE_FRIEND_CHALLENGE_REMOTE_ENABLED=
VITE_LIVEOPS_EVIDENCE_VERIFIED=

# Server/agent/CI-only secrets belong outside the app bundle:
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_DB_PASSWORD
# - SUPABASE_ACCESS_TOKEN
# - DEEPSEEK_API_KEY
# - APPS_IN_TOSS_CONSOLE_API_KEY
